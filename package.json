{
  "name": "image-format-converter",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "electron:start": "electron .",
    "electron:build": "npm run build && electron-builder --win --x64 --publish never",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "icons": "python scripts/make-icons.py"
  },
  "dependencies": {
    "file-saver": "^2.0.5",
    "gifenc": "^1.0.3",
    "heic2any": "^0.0.4",
    "jszip": "^3.10.1",
    "lucide-react": "^1.17.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "upng-js": "^2.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/file-saver": "^2.0.7",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/upng-js": "^2.1.5",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "^42.3.2",
    "electron-builder": "^26.8.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "terser": "^5.48.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^5.4.21"
  },
  "build": {
    "appId": "com.kishino.image-format-converter",
    "productName": "画像形式変換器",
    "directories": {
      "output": "dist-electron",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "build/icon.png",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "image-format-converter-${version}-win-x64.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "画像形式変換器"
    }
  },
  "productName": "画像形式変換器",
  "description": "HEIC・JPG・PNG・WebP・GIF・BMPをブラウザの中だけでPNG・JPG・WebPに一括変換",
  "author": "kishino",
  "license": "MIT",
  "homepage": "https://kishinoartworks.github.io/heic-converter/"
}
